            "url": { "raw": "{{base_url}}/stories", "host": ["{{base_url}}"], "path": ["stories"] },
            "description": "Create a new story using multipart/form-data API with all parameters and image file uploads."
          }
        },
        {
          "name": "Update Story",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "The Secret Listener (Updated)", "type": "text" },
                { "key": "description", "value": "Updated story description and plot line.", "type": "text" },
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "language", "value": "hi", "type": "text" },
                { "key": "tags", "value": "mystery, suspense", "type": "text" },
                { "key": "is_premium", "value": "1", "type": "text" },
                { "key": "status", "value": "completed", "type": "text" },
                { "key": "cover_image", "type": "file", "src": [] },
                { "key": "banner_image", "type": "file", "src": [] }
